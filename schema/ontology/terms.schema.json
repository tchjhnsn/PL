{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OntologyTerms",
  "type": "object",
  "additionalProperties": false,
  "required": ["terms"],
  "properties": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "definition"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^term\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": {
            "enum": ["frame", "tag", "measure", "typology"]
          },
          "definition": { "type": "string", "minLength": 1, "maxLength": 500 },
          "see": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
