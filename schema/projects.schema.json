{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "patterns", "start", "parameters"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/patternNumber" }
    },
    "start": { "$ref": "#/$defs/patternNumber" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": { "const": "si" },
        "climate": { "type": "string" },
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "by_pattern": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-3])$": {
              "$ref": "#/$defs/scalarObject"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "patternNumber": { "type": "integer", "minimum": 1, "maximum": 253 },
    "scalarObject": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean"]
      }
    }
  }
}
