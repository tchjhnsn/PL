{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "name",
    "scale",
    "confidence",
    "larger",
    "smaller",
    "summary",
    "forces",
    "conditions",
    "source"
  ],
  "properties": {
    "number": { "$ref": "#/$defs/patternNumber" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "scale": { "enum": ["town", "building", "construction"] },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 2 },
    "larger": { "$ref": "#/$defs/linkList" },
    "smaller": { "$ref": "#/$defs/linkList" },
    "summary": { "$ref": "#/$defs/summary" },
    "forces": {
      "type": "array",
      "items": { "$ref": "#/$defs/force" }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "source": { "$ref": "#/$defs/source" },
    "uses": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^term\\.[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "retrieved", "note"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 500 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "patternNumber": { "type": "integer", "minimum": 1, "maximum": 253 },
    "linkList": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/patternNumber" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "draft"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "draft": { "type": "boolean" }
      }
    },
    "force": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "draft"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "draft": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "number"],
      "properties": {
        "book": { "const": "A Pattern Language" },
        "number": { "$ref": "#/$defs/patternNumber" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": { "enum": ["computed", "judged", "unchecked"] },
        "check": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string", "boolean"]
          }
        },
        "question": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "computed" } }
          },
          "then": {
            "required": ["check", "params"],
            "properties": { "question": false }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "judged" } }
          },
          "then": {
            "required": ["question"],
            "properties": { "check": false, "params": false }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "unchecked" } }
          },
          "then": {
            "properties": {
              "check": false,
              "params": false,
              "question": false
            }
          }
        }
      ]
    }
  }
}
