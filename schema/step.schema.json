{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "before",
    "after",
    "pattern",
    "satisfied_before",
    "satisfied_after",
    "preserved"
  ],
  "properties": {
    "before": { "$ref": "#/$defs/modelRef" },
    "after": { "$ref": "#/$defs/modelRef" },
    "pattern": { "$ref": "#/$defs/patternNumber" },
    "satisfied_before": { "$ref": "#/$defs/patternList" },
    "satisfied_after": { "$ref": "#/$defs/patternList" },
    "preserved": { "type": "boolean" }
  },
  "$defs": {
    "patternNumber": { "type": "integer", "minimum": 1, "maximum": 253 },
    "patternList": {
      "type": "array",
      "items": { "$ref": "#/$defs/patternNumber" }
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
